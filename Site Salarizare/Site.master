<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.master.cs" Inherits="HtmlPage" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
    <style type="text/css">
        .auto-style1 {
            margin-bottom: 0px;
        }
    </style>
    </head>

<body style="height: 207px">
    <form id="form1" runat="server">
        <div>
            <asp:Menu ID="Menu1" runat="server"
                Orientation="Horizontal">
                <Items>
                    <asp:MenuItem Text="HOME"
                        NavigateUrl="~/Home.aspx">
                    </asp:MenuItem>

                    <asp:MenuItem Text="INTRODUCERE DATE"
                        Selectable="false">
                        <asp:MenuItem Text="Actualizare Date"
                            NavigateUrl="~/ActualizareDate.aspx">
                        </asp:MenuItem>
                        <asp:MenuItem Text="Adăugare angajați"
                            NavigateUrl="~/AdaugareAngajati.aspx">
                        </asp:MenuItem>
                        <asp:MenuItem Text="Ștergere angajați"
                            NavigateUrl="~/StergereAngajati.aspx">
                        </asp:MenuItem>
                        <asp:MenuItem Text="Calcul salarii"
                            NavigateUrl="~/CalculSalarii.aspx">
                        </asp:MenuItem>
                    </asp:MenuItem>

                    <asp:MenuItem Text="TIPĂRIRE">
                        <asp:MenuItem Text="Stat plată">
                        </asp:MenuItem>
                        <asp:MenuItem Text="Fluturași">
                        </asp:MenuItem>
                    </asp:MenuItem>

                    <asp:MenuItem Text="MODIF_PROCENTE"
                        NavigateUrl="~/ModificareProcente.aspx">
                    </asp:MenuItem>
                </Items>
            </asp:Menu>

            <asp:ContentPlaceHolder ID="MainContent"
                runat="server">
                <asp:Timer ID="Timer1" runat="server" OnTick="Timer1_Tick1">
                </asp:Timer>
                <asp:Image ID="Image1" runat="server" Height="132px" Width="187px" />
            </asp:ContentPlaceHolder>
            <asp:Label ID="Label1" runat="server" Text="Label"></asp:Label>
            <hr class="auto-style1" />

        </div>
    </form>
</body>
</html>
