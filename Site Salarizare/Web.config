      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.7.2" />
  </system.web>
  <connectionStrings>
    <add name="Oracle" connectionString="DATA SOURCE = localhost:1521 / xe; PASSWORD = student; USER ID = STUDENT;" providerName="System.Data.OracleClient" />
    <add name="ConnectionString" connectionString="USER ID=STUDENT;PASSWORD=student;DATA SOURCE=localhost:1521/xe;TNS_ADMIN=C:\Users\Admin\Oracle\network\admin;PERSIST SECURITY INFO=True" providerName="Oracle.ManagedDataAccess.Client" />
